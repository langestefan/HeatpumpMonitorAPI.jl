      "TimeseriesAvailable": {
        "type": "object",
        "description": "Result of /timeseries/available?id=...",
        "properties": {
          "feeds": {
            "type": "object",
            "description": "Map of feed name to feed descriptor.",
            "additionalProperties": { "$ref": "#/components/schemas/TimeseriesFeed" }
          },
          "start_date":   { "type": ["integer", "null"], "description": "Earliest sample timestamp across all feeds (unix epoch seconds)." },
          "config_cache": { "description": "Internal cache marker. Treat as opaque." }
        },
        "required": ["feeds"],
        "additionalProperties": true
      },
      "TimeseriesFeed": {
        "type": "object",
        "description": "Metadata for a single feed. `unit` is omitted for feeds whose unit is not configured upstream.",
        "properties": {
          "start_time": { "type": ["integer", "null"], "description": "Unix epoch seconds." },
          "end_time":   { "type": ["integer", "null"], "description": "Unix epoch seconds." },
          "interval":   { "type": ["number",  "null"], "description": "Mean sampling interval in seconds." },
          "npoints":    { "type": ["integer", "null"], "description": "Total number of samples." },
          "unit":       { "type": ["string",  "null"], "description": "Engineering unit (e.g. W, kWh, C). May be absent." }
        },
        "additionalProperties": true
      }
    }
  }
